# ============================================================
# SCRIORA — Canonical Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Only .env.example is committed.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scriora?schema=public"

# ── Redis (OAuth CSRF state + Agent Working/Ephemeral Memory) ─
REDIS_URL="redis://localhost:6379"

# ── Encryption (AES-256-GCM Master Key — HKDF derives per-workspace keys) ─
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARS_32_BYTES"

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_128_HEX_CHARS_64_BYTES"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── API Server ────────────────────────────────────────────────
API_PORT="4000"
API_HOST="0.0.0.0"
NODE_ENV="development"

# ── Web App ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"

# ── Telegram C2 Admin Bot (optional §14 approval delivery) ────
# When both are set, POST /v1/posts also sends an interactive approval card.
# The raw token is never stored; only SHA-256 tokenHash is persisted.
# TELEGRAM_ADMIN_CHAT_ID is required for C2 commands including /post.
# If unset, TelegramBotService.isAuthorized fails closed (no allow-all / DEV bypass).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""
# Required when more than one workspace exists; Telegram C2 will not pick the oldest.
# TELEGRAM_WORKSPACE_ID=""

# ── Inngest (Durable Execution Engine) ───────────────────────
INNGEST_SIGNING_KEY="REPLACE_WITH_INNGEST_SIGNING_KEY"
INNGEST_EVENT_KEY="REPLACE_WITH_INNGEST_EVENT_KEY"

# ── Email (Resend — Approval Magic Links + Notifications) ─────
RESEND_API_KEY="re_REPLACE_WITH_RESEND_API_KEY"
EMAIL_FROM="Scriora <no-reply@scriora.io>"

# ── Storage (Cloudflare R2 — Ephemeral Media Staging) ────────
R2_ACCOUNT_ID="REPLACE_WITH_R2_ACCOUNT_ID"
R2_ACCESS_KEY_ID="REPLACE_WITH_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="REPLACE_WITH_R2_SECRET_ACCESS_KEY"
R2_BUCKET="scriora-media-staging"
R2_PUBLIC_URL="https://media.scriora.io"

# ── OpenAI (Semantic Memory Embeddings — text-embedding-3-small) ─
OPENAI_API_KEY="sk-REPLACE_WITH_OPENAI_API_KEY"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS="1536"

# ── Social Platform OAuth Apps ────────────────────────────────
# LinkedIn
LINKEDIN_CLIENT_ID="REPLACE"
LINKEDIN_CLIENT_SECRET="REPLACE"

# X (Twitter)
X_CLIENT_ID="REPLACE"
X_CLIENT_SECRET="REPLACE"

# Instagram / Meta
INSTAGRAM_APP_ID="REPLACE"
INSTAGRAM_APP_SECRET="REPLACE"

# TikTok
TIKTOK_CLIENT_KEY="REPLACE"
TIKTOK_CLIENT_SECRET="REPLACE"

# YouTube / Google
GOOGLE_CLIENT_ID="REPLACE"
GOOGLE_CLIENT_SECRET="REPLACE"

# Threads (uses Instagram/Meta credentials)
# THREADS_APP_ID — shared with INSTAGRAM_APP_ID

# Facebook
FACEBOOK_APP_ID="REPLACE"
FACEBOOK_APP_SECRET="REPLACE"

# Bluesky (AT Protocol — no OAuth app needed, uses app password)
# Pinterest
PINTEREST_APP_ID="REPLACE"
PINTEREST_APP_SECRET="REPLACE"

# ── OAuth Redirect Base ───────────────────────────────────────
OAUTH_REDIRECT_BASE_URL="http://localhost:4000/v1/connect"

# ── Webhook Signing ───────────────────────────────────────────
# Per-workspace secrets are stored in DB. This is a global fallback.
WEBHOOK_GLOBAL_SECRET="REPLACE_WITH_64_HEX_CHARS"

# ── Feature Flags (DB-backed — loaded from workspace_settings) ─
# No external service required. Flags read from PostgreSQL at boot.

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL="info"
# Options: fatal | error | warn | info | debug | trace
