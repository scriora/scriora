# scriora-worker environment variables
# Reference: scriora-docs/architecture/SCRIORA_REPOSITORY_SPECIFICATIONS.md

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scriora?schema=public"

# Redis (distributed locks + idempotency cache)
REDIS_URL="redis://localhost:6379"

# Inngest (background job orchestration)
INNGEST_EVENT_KEY="dev-event-key"
INNGEST_SIGNING_KEY="dev-signing-key"

# Master encryption key (used when calling scriora-social)
MASTER_ENCRYPTION_KEY="replace-with-32-byte-hex-key"

# Object Storage
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET_NAME="scriora-dev"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_REGION="auto"