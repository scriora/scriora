# scriora-api environment variables
# Reference: scriora-docs/architecture/SCRIORA_REPOSITORY_SPECIFICATIONS.md

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Public origins. API_URL is mandatory in production and is used in magic links.
API_URL="http://localhost:4000"
APP_URL="http://localhost:3000"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scriora?schema=public"

# Redis (rate limiting + session cache)
REDIS_URL="redis://localhost:6379"

# Auth — HMAC secret used to sign and verify access/refresh JWTs (minimum 32 chars)
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

# Pepper for workspace API-key fingerprints (HMAC-SHA256). Not used for user
# passwords (those stay Argon2id). Legacy SHA-256(rawKey) rows still verify.
API_KEY_PEPPER="replace-with-random-pepper"

# CORS — comma-separated browser origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Magic-link delivery webhook accepting JSON: { email, url, expiresAt }
MAGIC_LINK_MAILER_URL=""

# Storage (for presigned URL generation)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET_NAME="scriora-dev"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_REGION="auto"
