# scriora-api environment variables
# Reference: scriora-docs/architecture/SCRIORA_REPOSITORY_SPECIFICATIONS.md

PORT=4000
LOG_LEVEL=info

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/scriora_dev"

# Redis (rate limiting + session cache)
REDIS_URL="redis://localhost:6379"

# Auth — RS256 public key for JWT verification
# Private key lives ONLY on the auth server, never here
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Storage (for presigned URL generation)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET_NAME="scriora-dev"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_REGION="auto"
