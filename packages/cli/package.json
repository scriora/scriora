    "ora": "^9.4.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0"
  },
  "packageManager": "pnpm@11.21.0"
