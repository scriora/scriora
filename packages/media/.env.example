# scriora-media environment variables
# Reference: scriora-docs/architecture/SCRIORA_REPOSITORY_SPECIFICATIONS.md

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/scriora_dev"

# Object Storage
STORAGE_PROVIDER="minio"
STORAGE_ACCESS_KEY_ID="minioadmin"
STORAGE_SECRET_ACCESS_KEY="minioadmin"
STORAGE_BUCKET_NAME="scriora-dev"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"

# FFmpeg binary path (injected in Docker)
FFMPEG_BINARY_PATH="/usr/bin/ffmpeg"

# Media limits
MEDIA_MAX_IMAGE_SIZE_MB=50
MEDIA_MAX_VIDEO_SIZE_GB=2
MEDIA_MAX_VIDEO_DURATION_SECONDS=3600

# Presigned URL TTL
MEDIA_PRESIGNED_UPLOAD_TTL_SECONDS=900
MEDIA_PRESIGNED_READ_TTL_SECONDS=900
