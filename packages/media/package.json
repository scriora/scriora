                     },
    "devDependencies":  {
                            "@biomejs/biome":  "^2.5.13",
                            "@types/fluent-ffmpeg":  "^2.1.28",
                            "@types/node":  "^22.20.2",
                            "fluent-ffmpeg":  "^2.1.3",
                            "typescript":  "^7.0.2",
                            "vitest":  "^5.0.0",
