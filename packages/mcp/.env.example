# scriora-mcp environment variables
# Reference: scriora-docs/architecture/SCRIORA_REPOSITORY_SPECIFICATIONS.md

DATABASE_URL="postgresql://postgres:password@localhost:5432/scriora_dev"
REDIS_URL="redis://localhost:6379"

# Workspace API key issued by POST /v1/workspaces/:id/api-keys (sk_live_... / sk_test_...)
# Required for workspace-scoped tools. Hash lookup is SHA-256(rawKey), same as the HTTP API.
SCRIORA_API_KEY="sk_live_replace-me"

# Optional alias for SCRIORA_API_KEY
# MCP_API_KEY="sk_live_replace-me"

# Reserved; not mixed into API key hashes (HTTP API stores SHA-256(rawKey) only).
MCP_API_KEY_SALT="replace-with-random-salt"

# Optional request HMAC. When set, workspace-scoped tools require MCP_REQUEST_SIGNATURE
# = hex(HMAC-SHA256(secret, "toolName:workspaceId"))
MCP_SIGNING_SECRET="replace-with-32-byte-hex-key"
# MCP_REQUEST_SIGNATURE=""

# Transport mode: stdio (default) | http
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=5000
