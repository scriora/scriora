# scriora-agent environment variables
# Reference: scriora-docs/architecture/SCRIORA_REPOSITORY_SPECIFICATIONS.md
DATABASE_URL="postgresql://postgres:password@localhost:5432/scriora_dev"
REDIS_URL="redis://localhost:6379"
# AI Providers — leave empty to run in Classic Mode (stub only)
# Classic Mode runs without ANY AI provider — fully functional
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_AI_API_KEY=""
# Default provider: stub | anthropic | openai | gemini
# ALWAYS start with stub. Only change after evaluation suite passes.
AGENT_DEFAULT_PROVIDER=stub
# Cost and resource guardrails
AGENT_MAX_DAILY_COST_USD=10
AGENT_MAX_TOKENS_PER_TASK=100000