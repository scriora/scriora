# scriora-social environment variables
# Reference: scriora-docs/architecture/SCRIORA_REPOSITORY_SPECIFICATIONS.md
#
# SECURITY NOTE: Platform credentials (access_token, refresh_token, client_secret)
# are NEVER stored as env vars — they are stored encrypted in the database.
# Only infrastructure config lives here.
# AES-256 key for encrypting stored platform tokens in DB
# Generate with: openssl rand -hex 32
SOCIAL_TOKEN_ENCRYPTION_KEY="replace-with-32-byte-hex-key"
